    <!-- Images Section Framework -->
    <section style="margin-bottom: 48px;">
        <h2 style="font-size: 1.4rem; font-weight: 600; margin-bottom: 16px; color: #111;">Gallery</h2>
        
        <!-- Clean, flexible image row -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px;">
            
            <!-- Image Item 1 -->
            <div style="background: #f0f0f0; border-radius: 6px; overflow: hidden; aspect-ratio: 4/3;">
                <img src="https://picsum.photos" alt="Description" style="width: 100%; height: 100%; object-fit: cover; display: block;">
            </div>

            <!-- Image Item 2 -->
            <div style="background: #f0f0f0; border-radius: 6px; overflow: hidden; aspect-ratio: 4/3;">
                <img src="https://picsum.photos" alt="Description" style="width: 100%; height: 100%; object-fit: cover; display: block;">
            </div>

            <!-- Image Item 3 -->
            <div style="background: #f0f0f0; border-radius: 6px; overflow: hidden; aspect-ratio: 4/3;">
                <img src="https://picsum.photos" alt="Description" style="width: 100%; height: 100%; object-fit: cover; display: block;">
            </div>

        </div>
    </section>
